mkdir -p dist prod && \
npx --yes esbuild src/main.js --minify --outfile=dist/main.min.js && \
npx --yes esbuild src/main.css --minify --outfile=dist/main.min.css && \
npx --yes esbuild src/research/research.js --minify --outfile=prod/research.min.js && \
npx --yes esbuild src/research/research.css --minify --outfile=prod/research.min.css && \
npx --yes esbuild src/research/leaderboard.js --minify --outfile=prod/leaderboard.min.js && \
npx --yes esbuild src/research/leaderboard.css --minify --outfile=prod/leaderboard.min.css && \
cp src/legal/cookie.html dist/cookie.html && \
rm -rf dist/benchmarks && \
cp -R src/benchmarks dist/benchmarks && \
rm -rf dist/robotics && \
cp -R src/robotics dist/robotics && \
git add src dist prod push.cli wrangler.jsonc && \
git add -u && \
git commit -m "release" && \
git push origin main && \
COMMIT=$(git rev-parse --short HEAD) && \
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner) && \
git tag -a "$COMMIT" -m "$COMMIT release" && \
git push origin "$COMMIT" && \
gh release create "$COMMIT" dist/main.min.js dist/main.min.css dist/cookie.html prod/*.js prod/*.css dist/robotics/*.html --generate-notes --title "$COMMIT" && \
echo "" && \
echo "main JS:     https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/main.min.js" && \
echo "main CSS:    https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/main.min.css" && \
echo "research JS: https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/prod/research.min.js" && \
echo "research CSS:https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/prod/research.min.css" && \
echo "leaderboard JS:  https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/prod/leaderboard.min.js" && \
echo "leaderboard CSS: https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/prod/leaderboard.min.css" && \
echo "inline JS:   https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/src/research/research-inline.js" && \
echo "cookie HTML: https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/cookie.html" && \
echo "universe JS: https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/src/human/universe-v1-embed.js" && \
echo "benchmarks:  https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/benchmarks/" && \
echo "  tax:       https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/benchmarks/tax/data.json" && \
echo "  legal:     https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/benchmarks/warren/data.json" && \
echo "  finance:   https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/benchmarks/quantis/data.json" && \
echo "  medical:   https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/benchmarks/medical/data.json" && \
echo "robotics:    https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/robotics/" && \
echo "  index:     https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/robotics/index.html" && \
echo "  e1 opus:   https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/robotics/trace_tube_stir_claude_opus_5.html" && \
echo "  e1 sonnet: https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/robotics/trace_tube_stir_claude_sonnet_5.html" && \
echo "  e2 opus:   https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/robotics/trace_claude_opus_5.html" && \
echo "  e2 sonnet: https://cdn.jsdelivr.net/gh/${REPO}@${COMMIT}/dist/robotics/trace_claude_sonnet_5.html"
